@page "/events"
@inject EventEase.Services.EventEaseService EventService
@inject NavigationManager Navigation

<h3>Upcoming Events</h3>

<div class="event-grid">
    @if (!EventService.GetAllEvents().Any())
    {
        <p>No events available. Please add some events.</p>
        <div class="event-card add-event-card" @onclick="AddEvent" type="button">
            <h3>+ Add New Event</h3>
        </div>
    }
    else
    {
        @foreach (var ev in PagedEvents)
        {
            <EventCard @key="ev.Id" Event="ev" />
        }

        <div class="event-card add-event-card" @onclick="AddEvent" type="button">
            <h3>+ Add New Event</h3>
        </div>
    }
</div>

<div class="pagination">
    <button class="btn btn-secondary" @onclick="PreviousPage" disabled="@(currentPage == 1)">Previous</button>
    <span>Page @currentPage of @TotalPages</span>
    <button class="btn btn-secondary" @onclick="NextPage" disabled="@(currentPage == TotalPages)">Next</button>
</div>


@code {
    private int currentPage = 1;
    private const int pageSize = 20;

    private IEnumerable<EventEase.Models.Event> PagedEvents =>
        EventService.GetAllEvents()
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize);

    private int TotalPages =>
        (int)Math.Max(1, Math.Ceiling(EventService.GetAllEvents().Count() / (double)pageSize));

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

    public void AddEvent()
    {
        Console.WriteLine("Add Event Clicked");
        // OnAdd.InvokeAsync();
        Navigation.NavigateTo("/add-event");
    }
}


<style>
    .event-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1em;
        padding: 20px 10px;
    }

    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        padding: 1rem 0;
    }

    .pagination .btn {
        min-width: 100px;
    }
</style>
